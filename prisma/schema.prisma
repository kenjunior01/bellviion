// Bellviion Dropshipping Store - Database Schema
// Optimized for international dropshipping (US/UK/CA/AU/EU) with PayPal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEON_POSTGRES_PRISMA_URL")
  directUrl = env("NEON_POSTGRES_URL_NON_POOLING")
}

// ============================================================
// CATEGORIES / PRODUCTS — preserva as tabelas existentes da loja
// ============================================================
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  icon        String?
  createdAt   DateTime? @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  artisticName  String?   @map("artistic_name")
  description   String?
  price         Decimal   @db.Decimal(12, 2)
  categoryId    String?   @db.Uuid @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageUrl      String?   @map("image_url")
  specs         Json?     @default("{}")
  isActive      Boolean?  @default(true) @map("is_active")
  stock         Int?      @default(0)
  createdAt     DateTime? @default(now()) @map("created_at")

  // Campos adicionados sem apagar os dados existentes
  slug          String    @unique @default(cuid())
  tagline       String?
  compareAtPrice Decimal? @db.Decimal(12, 2)
  cost          Decimal?  @db.Decimal(12, 2)
  images        String?
  rating        Float     @default(4.8)
  reviewCount   Int       @default(0)
  soldCount     Int       @default(0)
  badge         String?
  isTrending    Boolean   @default(false)
  seoTitle      String?
  seoDescription String?
  keywords      String?
  supplierCountry String?
  shippingDaysMin Int      @default(7)
  shippingDaysMax Int      @default(14)
  updatedAt     DateTime  @updatedAt

  @@map("products")
}

// ============================================================
// ORDERS - Pedidos internacionais
// ============================================================
model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  customerName   String
  email          String
  phone          String?
  country        String   // US, GB, CA, AU, DE, FR...
  state          String?
  city           String
  address1       String
  address2       String?
  zipCode        String
  currency       String   @default("USD")
  exchangeRate   Float    @default(1.0)
  subtotal       Float
  shipping       Float    @default(0)
  discount       Float    @default(0)
  total          Float
  // PayPal
  paypalOrderId  String?
  paypalCaptureId String?
  paymentStatus  String   @default("pending") // pending, paid, failed, refunded
  status         String   @default("processing") // processing, fulfilled, shipped, delivered, cancelled
  // Affiliate tracking
  referralCode   String?  // código de afiliado usado
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  couponCode     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  name       String  // snapshot do nome no momento da compra
  image      String?
  unitPrice  Float
  quantity   Int
  variant    String? // cor, tamanho etc.
}

// ============================================================
// REVIEWS - Prova social
// ============================================================
model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  country   String   @default("US")
  rating    Int      @default(5)
  title     String?
  content   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// SETTINGS - Configurações da loja (PayPal, moedas, etc)
// ============================================================
model Setting {
  key   String @id
  value String
}

// ============================================================
// SUBSCRIBERS - Newsletter (email marketing viral)
// ============================================================
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // popup, footer, checkout
  createdAt DateTime @default(now())
}

// ============================================================
// CLICKS - Tracking de afiliados e analytics
// ============================================================
model ClickEvent {
  id          String   @id @default(cuid())
  type        String   // referral, product_view, add_to_cart, share
  productId   String?
  referralCode String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country     String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

// ============================================================
// AFFILIATES - Programa de afiliados
// ============================================================
model Affiliate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  email       String   @unique
  commission  Float    @default(10) // % de comissão
  clicks      Int      @default(0)
  sales       Int      @default(0)
  earnings    Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
